# --- Model AI (Bagian 7.1) ---------------------------------------------------
# Tanpa kunci ini Recens tetap berjalan penuh: perhitungan statistik,
# pemeriksaan naskah, perenderan sitasi, dan perakitan format tidak
# memerlukan model bahasa sama sekali. Yang memakai jalur deterministik
# hanyalah fitur penyusunan kalimat.
ANTHROPIC_API_KEY=

# Model konteks panjang: menalar atas naskah utuh dan dokumen panjang.
# Menopang cek konsistensi, pemandu metodologi, mode siap sidang, pedoman kampus.
RECENS_LONG_CONTEXT_MODEL=claude-opus-5

# Model cepat: tugas bervolume tinggi dengan tuntutan latensi rendah.
# Menopang lanjutan kalimat, parafrase, koreksi bahasa.
RECENS_FAST_MODEL=claude-sonnet-5

# --- Literatur & sitasi ------------------------------------------------------
# Crossref meminta alamat surel untuk masuk kelompok layanan yang lebih cepat.
RECENS_CROSSREF_MAILTO=

# Semantic Scholar berjalan tanpa kunci, tetapi kunci menaikkan batas laju.
SEMANTIC_SCHOLAR_API_KEY=

# Garuda/SINTA tidak menyediakan API publik yang stabil. Isi dengan endpoint
# lembaga yang menyediakan metadata CSL-JSON. Bila kosong, Recens mengatakan
# sumber ini belum dikonfigurasi alih-alih mengarang hasil pencarian.
RECENS_GARUDA_BASE_URL=

# OpenAlex aktif secara bawaan.
RECENS_OPENALEX=1

# Matikan seluruh akses jaringan keluar (mis. untuk pengujian atau lingkungan
# tertutup). Referensi masih bisa ditambahkan lewat unggahan PDF.
RECENS_NETWORK=1
RECENS_HTTP_TIMEOUT=20

# --- Platform ----------------------------------------------------------------
RECENS_DATA_DIR=./recens_data
RECENS_HOST=127.0.0.1
RECENS_PORT=8000
